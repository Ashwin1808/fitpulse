FROM jenkins/inbound-agent:latest-jdk21

USER root

RUN apt-get update && apt-get install -y --no-install-recommends \
    docker-cli curl ca-certificates git jq tar \
    && ARCH=$(uname -m) \
    && case "$ARCH" in \
         aarch64|arm64) GL_ARCH="linux_arm64" ;; \
         x86_64|amd64)  GL_ARCH="linux_x64" ;; \
         *) echo "Unsupported arch: $ARCH"; exit 1 ;; \
       esac \
    && GL_URL=$(curl -fsSL https://api.github.com/repos/gitleaks/gitleaks/releases/latest \
         | jq -r --arg a "$GL_ARCH" '.assets[] | select(.name | contains($a) and endswith(".tar.gz")) | .browser_download_url' \
         | head -n 1) \
    && curl -fsSL "$GL_URL" -o /tmp/gitleaks.tar.gz \
    && tar -xzf /tmp/gitleaks.tar.gz -C /usr/local/bin gitleaks \
    && chmod +x /usr/local/bin/gitleaks \
    && rm -rf /tmp/gitleaks.tar.gz /var/lib/apt/lists/* \
    && docker --version && gitleaks version

USER jenkins
