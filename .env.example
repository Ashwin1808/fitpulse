COMPOSE_PROJECT_NAME=fitpulse
APP_ENV=dev
IMAGE_TAG=local
BIND_HOST=127.0.0.1
WEB_PORT=8080
COMMERCE_PORT=3000
TRACKING_PORT=8081
WORKER_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379
POSTGRES_DB=fitpulse
POSTGRES_USER=fitpulse
POSTGRES_PASSWORD=fitpulse_dev_db_password
REDIS_PASSWORD=fitpulse_dev_redis_password
CACHE_TTL_SECONDS=60
WORKER_STREAM_KEY=fitpulse:events
WORKER_CONSUMER_GROUP=fitpulse-workers
LOG_LEVEL=info
