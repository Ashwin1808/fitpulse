FROM jenkins/jenkins:lts-jdk21

USER root

# Install Docker CLI + base utilities
RUN apt-get update && apt-get install -y --no-install-recommends \
    docker.io curl unzip jq ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install Trivy (auto-detects arm64/amd64)
RUN curl -sfL https://raw.githubusercontent.com/aquasecurity/trivy/main/contrib/install.sh | sh -s -- -b /usr/local/bin

# Install Gitleaks (ARM64 Linux for Apple Silicon Docker)
RUN curl -sSfL https://github.com/gitleaks/gitleaks/releases/download/v8.30.1/gitleaks_8.30.1_linux_arm64.tar.gz \
    | tar -xz -C /usr/local/bin gitleaks

# Install SonarScanner CLI (ARM64 Linux)
RUN curl -sSfL https://binaries.sonarsource.com/Distribution/sonar-scanner-cli/sonar-scanner-cli-6.2.1.4610-linux-aarch64.zip -o /tmp/sonar.zip \
    && unzip -q /tmp/sonar.zip -d /opt \
    && mv /opt/sonar-scanner-* /opt/sonar-scanner \
    && ln -s /opt/sonar-scanner/bin/sonar-scanner /usr/local/bin/sonar-scanner \
    && rm -f /tmp/sonar.zip
